{
  "gnomad-genetics-mcp-server": {
    "command": "npx",
    "args": ["-y", "@cyanheads/gnomad-genetics-mcp-server"],
    "env_vars": ["GNOMAD_API_BASE_URL", "GNOMAD_DEFAULT_DATASET", "GNOMAD_REQUEST_TIMEOUT_MS", "GNOMAD_MAX_CONCURRENCY", "GNOMAD_MAX_VARIANT_BATCH", "CLINVAR_BASE_URL", "NCBI_API_KEY", "GNOMAD_DATAFRAME_DROP_ENABLED"],
    "env": {
      "MCP_TRANSPORT_TYPE": "stdio"
    }
  }
}
